# Copie para .env.local e preencha com os valores do seu projeto Supabase
# (Project Settings > API no painel da Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do app depois do deploy (ex.: https://fidelidade-friofrio.vercel.app,
# sem barra no final) — usada só para montar o link da página pública do
# cliente (/c/[token]) na mensagem de boas-vindas por WhatsApp no cadastro.
# Sem essa variável, o cadastro funciona normalmente, só não gera o link do
# WhatsApp (não dá pra montar um link público sem domínio público ainda).
NEXT_PUBLIC_SITE_URL=
